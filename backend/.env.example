# ========================================================
# RESUME BLASTER & HR EMAIL OUTREACH CONFIGURATION
# ========================================================

# Primary Gmail SMTP Credentials
GMAIL_USER=your_primary_email@gmail.com
# 16-character Gmail App Password (from https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Secondary Sending Accounts (Quad / Triple Account Autopilot)
GMAIL_USER_1=your_secondary_email_1@gmail.com
GMAIL_APP_PASSWORD_1=your_16_char_app_password
GMAIL_USER_2=your_secondary_email_2@gmail.com
GMAIL_APP_PASSWORD_2=your_16_char_app_password
GMAIL_USER_3=your_secondary_email_3@gmail.com
GMAIL_APP_PASSWORD_3=your_16_char_app_password
GMAIL_USER_4=your_secondary_email_4@gmail.com
GMAIL_APP_PASSWORD_4=your_16_char_app_password

# Server Port
PORT=5000

# ========================================================
# MAILBOX VERIFICATION PROVIDER INTERFACE
# ========================================================
# Leave blank or set to 'none' to use built-in RFC 5321 DNS MX + A/AAAA verification.
# To enable a third-party mailbox existence validation provider, choose one of:
# 'abstract', 'zerobounce', 'hunter'
EMAIL_VERIFICATION_PROVIDER=none
EMAIL_VERIFICATION_API_KEY=

# Provider-Specific API Keys (Alternative to EMAIL_VERIFICATION_API_KEY):
# 1. Abstract API: https://www.abstractapi.com/api/email-verification-validation-api
# ABSTRACT_API_KEY=your_abstract_api_key

# 2. ZeroBounce API: https://www.zerobounce.net/
# ZEROBOUNCE_API_KEY=your_zerobounce_api_key

# 3. Hunter.io API: https://hunter.io/api-documentation/v2#email-verifier
# HUNTER_API_KEY=your_hunter_api_key
